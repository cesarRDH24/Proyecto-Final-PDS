<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.polloshermanos.controllers.InicioMeseroController">

    <children>

        <VBox layoutX="50.0"
              layoutY="21.0"
              prefHeight="220.0"
              prefWidth="500.0"
              spacing="20.0">

            <padding>
                <Insets bottom="15"
                        left="15"
                        right="15"
                        top="15" />
            </padding>

            <!-- TITULO -->
            <Label text="Panel del Mesero"
                   style="-fx-text-fill: white;
                          -fx-font-size: 24px;
                          -fx-font-weight: bold;" />

            <!-- BOTONES -->
            <HBox spacing="15">

                <!-- TOMAR PEDIDO -->
                <Button fx:id="btnTomarPedido"
                        onAction="#abrirTomarPedido"
                        prefHeight="80"
                        prefWidth="150"
                        text="Tomar Pedido"
                        style="-fx-background-color: #007bff;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;" />

                <!-- PEDIDOS -->
                <Button fx:id="btnPedidos"
                        onAction="#abrirModuloPedidos"
                        prefHeight="80"
                        prefWidth="150"
                        text="Pedidos"
                        style="-fx-background-color: #28a745;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;" />

                <!-- AGREGAR CONSUMO -->
                <Button fx:id="btnAgregarConsumo"
                        onAction="#abrirAgregarConsumo"
                        prefHeight="80"
                        prefWidth="150"
                        text="Agregar Consumo"
                        style="-fx-background-color: #ffc107;
                               -fx-text-fill: black;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;" />

            </HBox>

        </VBox>

        <!-- CERRAR SESIÓN -->
        <Button layoutX="230.0"
                layoutY="300.0"
                onAction="#salirAlLogin"
                prefHeight="45"
                prefWidth="140"
                text="Cerrar Sesión"
                style="-fx-background-color: #dc3545;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;" />

    </children>

</AnchorPane>