<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0"
            prefWidth="600.0"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.polloshermanos.controllers.MeseroPedidosController"
            style="-fx-background-color: #1e1e1e;">

    <children>

        <VBox spacing="20"
              alignment="CENTER"
              AnchorPane.topAnchor="30"
              AnchorPane.bottomAnchor="30"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- TITULO -->
            <Label text="Gestión de Pedidos"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;" />

            <!-- PEDIDOS EN PREPARACION -->
            <Button text="Pedidos en Preparación"
                    fx:id="btnPreparacion"
                    onAction="#abrirPedidosPreparacion"
                    prefWidth="280"
                    prefHeight="70"
                    wrapText="true"
                    style="-fx-background-color: #ffc107;
                           -fx-text-fill: black;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;" />

            <!-- PEDIDOS LISTOS -->
            <Button text="Pedidos Listos"
                    fx:id="btnListos"
                    onAction="#abrirPedidosListos"
                    prefWidth="280"
                    prefHeight="70"
                    style="-fx-background-color: #28a745;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;" />

            <!-- CANCELAR PEDIDO -->
            <Button text="Cancelar Pedido"
                    fx:id="btnCancelar"
                    onAction="#abrirCancelarPedido"
                    prefWidth="280"
                    prefHeight="70"
                    style="-fx-background-color: #dc3545;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;" />

            <!-- REGRESAR -->
            <Button text="Regresar"
                    fx:id="btnRegresar"
                    onAction="#regresar"
                    prefWidth="200"
                    prefHeight="50"
                    style="-fx-background-color: #6c757d;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;" />

        </VBox>

    </children>

</AnchorPane>