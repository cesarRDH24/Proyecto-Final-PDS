<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: F2C03D;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.polloshermanos.controllers.ActualizarMenuController">
   <children>
      <Label layoutX="153.0" layoutY="14.0" text="Actualizar Menu">
         <font>
            <Font name="Century Schoolbook Bold Italic" size="30.0" />
         </font>
      </Label>
      <TableView fx:id="tablaProductos" layoutX="23.0" layoutY="70.0" prefHeight="310.0" prefWidth="226.0">
        <columns>
          <TableColumn fx:id="colPlatilloAM" prefWidth="159.20001220703125" text="Platillo" />
          <TableColumn fx:id="colPrecioAM" prefWidth="65.60001220703126" text="Precio" />
        </columns>
      </TableView>
      <Button fx:id="agregarProducto" layoutX="283.0" layoutY="327.0" mnemonicParsing="false" onAction="#agregarProducto" prefHeight="30.0" prefWidth="114.0" style="-fx-background-color: FA0707;" text="Agregar Producto" textFill="WHITE">
         <font>
            <Font name="Bell MT Bold" size="12.0" />
         </font></Button>
      <Button fx:id="eliminarProducto" layoutX="422.0" layoutY="327.0" mnemonicParsing="false" onAction="#eliminarProducto" prefHeight="30.0" prefWidth="114.0" style="-fx-background-color: FA0707;" text="Eliminar Producto" textFill="#fffcfc">
         <font>
            <Font name="Bell MT Bold" size="12.0" />
         </font></Button>
      <ImageView fitHeight="145.0" fitWidth="159.0" layoutX="441.0" layoutY="70.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/actualizarMenu.jpeg" />
         </image>
      </ImageView>
      <TextField fx:id="txtNombre" layoutX="273.0" layoutY="88.0" promptText="Nombre del Platillo" />
      <TextField fx:id="txtPrecio" layoutX="273.0" layoutY="130.0" promptText="Precio Platillo" />
      <Button fx:id="btnVolverAdmin" layoutX="23.0" layoutY="33.0" mnemonicParsing="false" onAction="#volverInicioAdmin" style="-fx-background-color: FA0707;" text="Back" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
      </Button>
      <TextField fx:id="txtStock" layoutX="273.0" layoutY="212.0" promptText="Stock" />
      <TextField fx:id="txtDescripcion" layoutX="273.0" layoutY="256.0" prefHeight="46.0" prefWidth="238.0" promptText="Descripcion" />
      <ComboBox fx:id="comboCategoria" layoutX="272.0" layoutY="168.0" prefWidth="150.0" promptText="Categoria" />
   </children>
</AnchorPane>