<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.polloshermanos.controllers.CancelarPedidoController">

    <children>

        <Label layoutX="25.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Cancelar Pedido" />

        <Label layoutX="25.0" layoutY="75.0" text="Buscar Pedido:" />

        <TextField fx:id="txtBuscar" layoutX="130.0" layoutY="70.0" prefHeight="30.0" prefWidth="220.0" promptText="Ingrese ID o mesa" />

        <Button fx:id="btnBuscar" layoutX="370.0" layoutY="70.0" mnemonicParsing="false" onAction="#buscarPedido" prefHeight="30.0" prefWidth="100.0" text="Buscar" />

        <TableView fx:id="tablaPedidos" layoutX="25.0" layoutY="120.0" prefHeight="280.0" prefWidth="740.0">

            <columns>

                <TableColumn fx:id="colId" prefWidth="80.0" text="ID Pedido" />

                <TableColumn fx:id="colMesa" prefWidth="100.0" text="Mesa" />

                <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />

                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total" />

                <TableColumn fx:id="colFecha" prefWidth="250.0" text="Fecha" />
                

            </columns>

        </TableView>

        <Button fx:id="btnCancelarPedido" layoutX="25.0" layoutY="430.0" mnemonicParsing="false" onAction="#cancelarPedido" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;" text="Cancelar Pedido" />

        <Button fx:id="btnActualizar" layoutX="225.0" layoutY="430.0" mnemonicParsing="false" onAction="#actualizarTabla" prefHeight="40.0" prefWidth="180.0" text="Actualizar Lista" />
        
        <Button fx:id="btnSalir"
        layoutX="600.0"
        layoutY="430.0"
        mnemonicParsing="false"
        onAction="#salir"
        prefHeight="40.0"
        prefWidth="150.0"
        text="Salir" />

        <Label fx:id="lblMensaje" layoutX="25.0" layoutY="475.0" prefWidth="500.0" style="-fx-text-fill: green; -fx-font-weight: bold;" />

    </children>

</AnchorPane>
