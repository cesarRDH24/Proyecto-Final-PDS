<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="620.0"
            style="-fx-background-color: E62D09;"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/25"
            fx:controller="com.mycompany.polloshermanos.controllers.ReporteDiarioController">
   <children>

      <Label layoutX="150.0" layoutY="20.0"
             text="Reporte Diario de Ventas"
             textFill="WHITE">
         <font><Font name="Cooper Black" size="26.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="75.0"
             text="Selecciona la fecha:"
             textFill="WHITE">
         <font><Font name="Lucida Bright Demibold Italic" size="13.0"/></font>
      </Label>

      <DatePicker fx:id="datePicker"
                  layoutX="170.0" layoutY="70.0"
                  prefWidth="160.0"/>

      <Button fx:id="btnGenerar"
              layoutX="345.0" layoutY="70.0"
              text="Generar"
              onAction="#generarReporte"
              style="-fx-background-color: FFEC0A;"
              prefWidth="100.0" prefHeight="31.0">
         <font><Font name="Lucida Bright Demibold Italic" size="13.0"/></font>
      </Button>

      <TableView fx:id="tablaReporte"
                 layoutX="20.0" layoutY="115.0"
                 prefHeight="240.0" prefWidth="580.0">
         <columns>
            <TableColumn fx:id="colNombre"    text="Producto"   prefWidth="200"/>
            <TableColumn fx:id="colCategoria" text="Categoría"  prefWidth="100"/>
            <TableColumn fx:id="colVendido"   text="Vendidos"   prefWidth="90"/>
            <TableColumn fx:id="colIngreso"   text="Total ($)"  prefWidth="150"/>
         </columns>
      </TableView>

      <Button fx:id="btnExportar"
              layoutX="200.0" layoutY="368.0"
              text="Exportar .txt"
              onAction="#exportarReporte"
              style="-fx-background-color: FFEC0A;"
              prefWidth="120.0" prefHeight="31.0">
         <font><Font name="Lucida Bright Demibold Italic" size="13.0"/></font>
      </Button>

      <Button fx:id="btnVolver"
              layoutX="530.0" layoutY="368.0"
              text="Volver"
              onAction="#volverAdmin"
              style="-fx-background-color: FFEC0A;"
              prefWidth="64.0" prefHeight="31.0">
         <font><Font name="Lucida Bright Demibold Italic" size="13.0"/></font>
      </Button>

   </children>
</AnchorPane>