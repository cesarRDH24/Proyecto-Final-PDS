<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: FFE600;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.polloshermanos.controllers.PagoController">

