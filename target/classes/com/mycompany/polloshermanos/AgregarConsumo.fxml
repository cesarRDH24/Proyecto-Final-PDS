<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.polloshermanos.controllers.AgregarConsumoController"
      spacing="12" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Agregar Consumo" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label fx:id="lblIdPedido" style="-fx-font-size: 16px; -fx-text-fill: #555;"/>
        <Label fx:id="lblTotal"    style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
    </HBox>

    <Separator/>
    
    <VBox spacing="6">
    <Label text="1. Selecciona el pedido activo"
           style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
    <TableView fx:id="tablaPedidos" prefHeight="150">
        <columns>
            <TableColumn fx:id="colIdPedido" text="# Pedido" prefWidth="80"/>
            <TableColumn fx:id="colMesa"     text="Mesa"     prefWidth="80"/>
            <TableColumn fx:id="colEstado"   text="Estado"   prefWidth="130"/>
        </columns>
    </TableView>
    <Button fx:id="btnSeleccionarPedido"
            text="✔ Seleccionar este pedido"
            onAction="#seleccionarPedido"
            maxWidth="Infinity"
            style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>

<Separator/>
<Label text="2. Agrega productos al pedido seleccionado"
       style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Menú disponible" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colNombre"    text="Producto"  prefWidth="160"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="110"/>
                    <TableColumn fx:id="colPrecio"    text="Precio"    prefWidth="80"/>
                    <TableColumn fx:id="colStock"     text="Stock"     prefWidth="60"/>
                </columns>
            </TableView>
            <Button fx:id="btnAgregar" text="➕ Agregar al carrito"
                    onAction="#agregarAlCarrito" maxWidth="Infinity"
                    style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Productos seleccionados" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tablaCarrito" VBox.vgrow="ALWAYS" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colCarritoNombre" text="Producto" prefWidth="160"/>
                    <TableColumn fx:id="colCarritoPrecio" text="Precio"   prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

    </HBox>

    <Separator/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="btnRegresar"  text="← Regresar"
                onAction="#regresar"
                style="-fx-background-color: #757575; -fx-text-fill: white;"/>
        <Button fx:id="btnCancelar"  text="✖ Cancelar"
                onAction="#cancelarAgregado"
                style="-fx-background-color: #c62828; -fx-text-fill: white;"/>
        <Button fx:id="btnConfirmar" text="✔ Confirmar consumo"
                onAction="#confirmarConsumo"
                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>