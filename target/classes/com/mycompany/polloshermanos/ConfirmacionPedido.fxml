<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="539.0" prefWidth="432.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.polloshermanos.controllers.ConfirmacionPedidoController">
   <children>
      <BorderPane layoutX="10.0" layoutY="10.0" style="-fx-background-color: FFE600;">
         <center>
            <VBox alignment="CENTER" prefHeight="515.0" prefWidth="400.0" spacing="10">
               <children>
                  <Label contentDisplay="CENTER" prefHeight="23.0" prefWidth="250.0" style="-fx-background-color: #D1201D; -fx-background-radius: 10;" text="Confirmacion del Pedido" textAlignment="CENTER" textFill="#f4eeee" textOverrun="LEADING_ELLIPSIS">
                     <font>
                        <Font name="SansSerif Bold" size="20.0" />
                     </font>
                  </Label>
                  <TableView fx:id="tablaProductos" prefWidth="400" style="-fx-border-radius: 0;">
                     <columns>
                        <TableColumn fx:id="colNombre" prefWidth="200" text="Nombre" />
                        <TableColumn fx:id="colPrecio" prefWidth="200" text="Precio" />
                     </columns>
                  </TableView>
                  <Button fx:id="btnCrear2" onAction="#confirmarPedido" prefHeight="25.0" prefWidth="102.0" style="-fx-background-color: red; -fx-text-fill: white;" text="CONFIRMAR" />
                  <Button fx:id="btnCrear21" onAction="#cancelar" prefHeight="25.0" prefWidth="102.0" style="-fx-background-color: red; -fx-text-fill: white;" text="CANCELAR" />
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
