         <font>
            <Font name="Lucida Bright Demibold Italic" size="14.0" />
         </font>
      </Button>
      <Button fx:id="btnReporteMensual" layoutX="384.0" layoutY="295.0" mnemonicParsing="false" onAction="#abrirReporteMensual" prefHeight="46.0" prefWidth="170.0" style="-fx-background-color: FFEC0A;" text="Reporte Mensual">
