      </Button>
      <Button fx:id="btnReporte" layoutX="384.0" layoutY="170.0" mnemonicParsing="false" onAction="#abrirReporte" prefHeight="46.0" prefWidth="170.0" style="-fx-background-color: FFEC0A;" text="Gestionar Inventario">
