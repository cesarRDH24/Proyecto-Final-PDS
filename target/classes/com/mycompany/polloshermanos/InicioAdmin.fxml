      </Label>
      <ImageView fitHeight="218.0" fitWidth="222.0" layoutX="27.0" layoutY="119.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/polloAdmin.jpeg" />
         </image>
      </ImageView>
      <Button fx:id="btnVolver" layoutX="34.0" layoutY="344.0" mnemonicParsing="false" onAction="#volverLogin" prefHeight="31.0" prefWidth="64.0" style="-fx-background-color: FFEC0A;" text="Volver">
