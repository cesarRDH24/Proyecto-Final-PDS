<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="426.0" prefWidth="639.0" style="-fx-background-color: E62D09;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.polloshermanos.controllers.ReportePlatillosController">
   <children>

      <Label layoutX="133.0" layoutY="14.0" text="Reporte de Platillos y Bebidas" textAlignment="CENTER" textFill="WHITE">
         <font><Font name="Cooper Black" size="26.0" /></font>
      </Label>

      <TableView fx:id="tablaReporte" layoutX="20.0" layoutY="70.0" prefHeight="290.0" prefWidth="602.0">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="200" text="Producto" />
            <TableColumn fx:id="colCategoria" prefWidth="110" text="Categoría" />
            <TableColumn fx:id="colVendido" prefWidth="100" text="Vendidos" />
            <TableColumn fx:id="colStock" prefWidth="120" text="Stock actual" />
         </columns>
      </TableView>

      <Button fx:id="btnVolver" layoutX="20.0" layoutY="380.0" onAction="#volverAdmin" prefHeight="31.0" prefWidth="64.0" style="-fx-background-color: FFEC0A;" text="Volver">
         <font><Font name="Lucida Bright Demibold Italic" size="13.0" /></font>
      </Button>
      <Button fx:id="btnReabastecer" layoutX="428.0" layoutY="380.0" mnemonicParsing="false" onAction="#reabastecer" prefHeight="31.0" prefWidth="194.0" style="-fx-background-color: FFEC0A;" text="Solicitar mas de este producto">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

   </children>
</AnchorPane>
