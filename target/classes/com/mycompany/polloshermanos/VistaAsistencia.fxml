<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: F0CE3A;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.polloshermanos.controllers.VistaAsistenciaController">
    <TableView fx:id="tablaAsistencias" layoutY="52.0" prefHeight="384.0" prefWidth="626.0" style="-fx-background-color: C9C0A3;">
    <columns>
        <TableColumn fx:id="colNombre" prefWidth="200" text="Empleado" />
        <TableColumn fx:id="colFecha" prefWidth="200" text="Fecha" />
        <TableColumn fx:id="colHora" prefWidth="200" text="Hora Entrada" />
    </columns>
</TableView>
   <Label layoutX="123.0" prefHeight="43.0" prefWidth="439.0" text="Asistencia de los empleados">
      <font>
         <Font name="Goudy Old Style Bold" size="36.0" />
      </font>
   </Label>
   <Button fx:id="btnRegresarGerente" layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#backInicioGerente" style="-fx-background-color: ABA2A2;" text="Volver">
      <font>
         <Font name="System Bold Italic" size="12.0" />
      </font>
   </Button>

</AnchorPane>