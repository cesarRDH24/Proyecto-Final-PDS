<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.polloshermanos.controllers.CrearReservacionController"
      spacing="10"
      alignment="CENTER"
      style="-fx-padding: 20;">

    <Label text="Crear Reservación"/>

    <TextField fx:id="txtCliente" promptText="ID Cliente"/>

    <DatePicker fx:id="datePicker"/>

    <TextField fx:id="txtHora" promptText="Hora (HH:MM)"/>

    <Button text="Crear" onAction="#crearReservacion"/>

</VBox>